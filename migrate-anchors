#!/usr/bin/env python3
"""migrate-anchors -- rewrite heading ids from `{#id}` to `<a id="id"></a>`.

    docs/bin/migrate-anchors            what would change (nothing is written)
    docs/bin/migrate-anchors --write    rewrite the files in place

GitHub shows `{#id}` as literal text and gives the heading no link target, so
`<file>.md#id` does not open the section there. `<a id="id"></a>` renders as
nothing and GitHub keeps it as the target of `#id` (see `doc url`). The id
itself is unchanged, so every `topic#id` reference keeps resolving.

Kept apart from `doc` because `doc` never writes. Headings are found with
`doc`'s own parser (load the sibling `doc` script), so fenced examples and
indented lines are left alone exactly as `doc` already ignores them.
"""
import re
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

HERE = Path(__file__).resolve().parent
doc = SourceFileLoader("doctool", str(HERE / "doc")).load_module()

BRACE_RE = re.compile(r"\s*\{#(%s)\}\s*$" % doc._ID_CHARS)


def main(argv):
    write = "--write" in argv
    rest = [a for a in argv if a != "--write"]
    if rest[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if rest[:1] == ["--root"] and len(rest) > 1:
        root = Path(rest[1])
    else:
        root = doc.find_root()
    changed_files = changed = 0
    # load(), not load_all(): an aggregated submodule is its own repository
    # and is migrated from there.
    for d in doc.load(root):
        lines = list(d.lines)
        hits = []
        for s in d.sections:
            if s.anchor != "brace":
                continue
            i = s.start - 1
            new = BRACE_RE.sub(lambda m: ' <a id="%s"></a>' % m.group(1), lines[i])
            if new != lines[i]:
                hits.append((s.start, lines[i], new))
                lines[i] = new
        if not hits:
            continue
        changed_files += 1
        changed += len(hits)
        if write:
            # Re-read rather than join d.lines: Doc drops trailing blank lines.
            text = d.path.read_text(encoding="utf-8")
            src = text.split("\n")
            for ln, old, new in hits:
                assert src[ln - 1] == old, (d.rel, ln)
                src[ln - 1] = new
            d.path.write_text("\n".join(src), encoding="utf-8")
        else:
            for ln, old, new in hits:
                print("%s:%d\n  - %s\n  + %s" % (d.rel, ln, old, new))
    print("# %d 見出し / %d ファイル%s" % (
        changed, changed_files, "を書き換えた" if write else "(--write で書き換える)"))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
